# Supabase: configurar somente no servidor
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: segredo estável para identidades locais
APP_SESSION_SECRET=
# Somente servidor único com disco persistente; não usar em serverless
ALLOW_LOCAL_STORE=

# Painel administrativo: nunca colocar senha em texto puro neste arquivo.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
